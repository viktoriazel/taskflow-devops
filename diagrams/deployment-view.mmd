    APPDNS["<div style='text-align:center'><b>taskflow.plus</b></div><div style='text-align:left'>• Route 53 record · ACM certificate</div>"]

    WHDNS["<div style='text-align:center'><b>jenkins.taskflow.plus</b></div><div style='text-align:left'>• Route 53 record · ACM certificate</div>"]

    PF["<div style='text-align:center'><b>Operator Access</b></div><div style='text-align:left'>• kubectl port-forward · no public address<br/>• Jenkins UI · Prometheus<br/>• Grafana · Alertmanager<br/>• No public ingress for any of them</div>"]

    %% -----------------------------------------------------
    %% CUSTOMER VPC
    %% -----------------------------------------------------

    subgraph VPC["<b><span style='font-size:24px'>Customer VPC · 2 Availability Zones</span></b>"]

        subgraph PUBSUB["<b><span style='font-size:20px'>Public subnets</span></b>"]

            APPALB["<div style='text-align:center'><b>Application HTTPS ALB</b></div><div style='text-align:left'>• Open to the internet<br/>• Public /metrics answered with a fixed 404<br/>• Target type ip · reaches Pod IPs</div>"]

            WHALB["<div style='text-align:center'><b>Webhook HTTPS ALB</b></div><div style='text-align:left'>• Publishes only /github-webhook/<br/>• Restricted to GitHub CIDRs<br/>• Target type ip · reaches Pod IPs</div>"]

        end

        subgraph APPSIDE["<b><span style='font-size:22px'>Application side</span></b>"]
        direction TB

            subgraph APPNS["<b><span style='font-size:20px'>namespace devops-app</span></b>"]
            direction TB

                subgraph APPPODS["<b><span style='font-size:18px'>Workload Pods · Deployments</span></b>"]

                    FRONTEND["<div style='text-align:center'><b>Frontend</b></div><div style='text-align:left'>• 2 replicas · Deployment<br/>• SA taskflow-frontend<br/>• No AWS role</div>"]

                    BACKEND["<div style='text-align:center'><b>Backend</b></div><div style='text-align:left'>• 2 replicas · Deployment<br/>• SA taskflow-backend<br/>• Pod Identity → S3</div>"]

                    WORKER["<div style='text-align:center'><b>Worker</b></div><div style='text-align:left'>• 2 replicas · Deployment<br/>• SA taskflow-worker<br/>• Pod Identity → application SNS</div>"]

                end

                APPRES["<div style='text-align:center'><b>Namespace-scoped objects</b></div><div style='text-align:left'>• Ingress · ClusterIP Services<br/>• ConfigMap · Secrets<br/>• Scheduled onto no node</div>"]

                SMAPP["<div style='text-align:center'><b>ServiceMonitors</b></div><div style='text-align:left'>• frontend · backend · worker<br/>• Port http · path /metrics<br/>• Scheduled onto no node</div>"]

            end

            NGAPP["<div style='text-align:center'><b>Application Node Group</b></div><div style='text-align:left'>• 3 × t3.small<br/>• Private application subnets</div>"]

            subgraph APPDB["<b><span style='font-size:18px'>Private database subnets</span></b>"]

                RDS[("<div style='text-align:center'><b>Amazon RDS PostgreSQL</b></div><div style='text-align:left'>• Managed PostgreSQL instance<br/>• Private · no internet route</div>")]

            end

        end

        subgraph JENSIDE["<b><span style='font-size:22px'>Jenkins side</span></b>"]
        direction TB

            subgraph JENKINSNS["<b><span style='font-size:20px'>namespace jenkins</span></b>"]
            direction TB

                subgraph JENPODS["<b><span style='font-size:18px'>Controller and Agent Pods</span></b>"]

                    CTRL["<div style='text-align:center'><b>Jenkins Controller</b></div><div style='text-align:left'>• Permanent Pod · numExecutors 0<br/>• Schedules work onto agent Pods<br/>• No application deploy permissions</div>"]

                    CIAG["<div style='text-align:center'><b>CI Agent</b></div><div style='text-align:left'>• Ephemeral Pod · SA jenkins-ci-agent<br/>• Pod Identity → ECR push<br/>• No Kubernetes deploy access</div>"]

                    CDAG["<div style='text-align:center'><b>CD Agent</b></div><div style='text-align:left'>• Ephemeral Pod · SA jenkins-cd-agent<br/>• Limited deploy RBAC<br/>• ECR metadata read-only</div>"]

                end

                JSVC["<div style='text-align:center'><b>Jenkins Service</b></div><div style='text-align:left'>• ClusterIP · selects the Controller Pod<br/>• Scheduled onto no node</div>"]

                JMSVC["<div style='text-align:center'><b>jenkins-metrics Service</b></div><div style='text-align:left'>• ClusterIP · controller metrics only<br/>• Scheduled onto no node</div>"]

                JSMON["<div style='text-align:center'><b>ServiceMonitor jenkins-metrics</b></div><div style='text-align:left'>• Path /prometheus/ · interval 60s<br/>• Scheduled onto no node</div>"]

                JRES["<div style='text-align:center'><b>Jenkins configuration</b></div><div style='text-align:left'>• JCasC · plugins · Job DSL<br/>• Kubernetes Secrets · webhook Ingress<br/>• Scheduled onto no node</div>"]

                JPVC[("<div style='text-align:center'><b>Jenkins Home PVC</b></div><div style='text-align:left'>• StorageClass taskflow-gp3<br/>• Scheduled onto no node</div>")]

            end

            NGJEN["<div style='text-align:center'><b>Jenkins Node Group</b></div><div style='text-align:left'>• 1 × m7i-flex.large<br/>• Private application subnet · single AZ<br/>• Taint workload=jenkins:NoSchedule</div>"]

        end

        subgraph OBSSIDE["<b><span style='font-size:22px'>Observability side</span></b>"]
        direction TB

            subgraph OBSNS["<b><span style='font-size:20px'>namespace observability</span></b>"]
            direction TB

                subgraph OBSPODS["<b><span style='font-size:18px'>Monitoring Pods</span></b>"]

                    PROM["<div style='text-align:center'><b>Prometheus</b></div><div style='text-align:left'>• Scrapes application, Jenkins and cluster<br/>• Evaluates the alert rules<br/>• Retention 7d / 6GiB</div>"]

                    GRAF["<div style='text-align:center'><b>Grafana</b></div><div style='text-align:left'>• Dashboards provisioned from code<br/>• Prometheus datasource · no ingress</div>"]

                    ALERTM["<div style='text-align:center'><b>Alertmanager</b></div><div style='text-align:left'>• Groups and routes alerts<br/>• SA alertmanager<br/>• Pod Identity → alerts SNS</div>"]

                    KSM["<div style='text-align:center'><b>kube-state-metrics</b></div><div style='text-align:left'>• Exposes Kubernetes object state<br/>• Reads state from the control plane</div>"]

                    PROMOP["<div style='text-align:center'><b>Prometheus Operator</b></div><div style='text-align:left'>• Reconciles ServiceMonitors and rules<br/>• Configures Prometheus discovery</div>"]

                end

                NODEEXP["<div style='text-align:center'><b>node-exporter</b></div><div style='text-align:left'>• DaemonSet · one Pod on every node<br/>• Exposes host metrics</div>"]

                OBSRES["<div style='text-align:center'><b>Namespace-scoped objects</b></div><div style='text-align:left'>• PrometheusRule · ClusterIP Services<br/>• NetworkPolicies<br/>• Scheduled onto no node</div>"]

                OBSPVC[("<div style='text-align:center'><b>Prometheus Storage PVC</b></div><div style='text-align:left'>• 10 GiB · StorageClass taskflow-gp3<br/>• Scheduled onto no node</div>")]

            end

        end

    end

    %% -----------------------------------------------------
    %% CONTROL PLANE
    %% -----------------------------------------------------

    KAPI["<div style='text-align:center'><b>EKS Control Plane</b></div><div style='text-align:left'>• Cluster taskflow-dev-eks<br/>• AWS-managed · outside the VPC</div>"]

    %% -----------------------------------------------------
    %% AWS-MANAGED SERVICES OUTSIDE THE VPC
    %% -----------------------------------------------------

    subgraph OUTSIDE["<b><span style='font-size:22px'>AWS managed services</span></b>"]

        ECR["<div style='text-align:center'><b>Amazon ECR</b></div><div style='text-align:left'>• 3 repositories · immutable tags</div>"]

        EBS["<div style='text-align:center'><b>Amazon EBS</b></div><div style='text-align:left'>• gp3 · Jenkins home<br/>• gp3 · Prometheus data</div>"]

        S3["<div style='text-align:center'><b>Amazon S3</b></div><div style='text-align:left'>• Private uploads bucket</div>"]

        SNS["<div style='text-align:center'><b>Amazon SNS · application</b></div><div style='text-align:left'>• TaskFlow notifications</div>"]

        SNSALERT["<div style='text-align:center'><b>Amazon SNS · alerts</b></div><div style='text-align:left'>• Topic taskflow-dev-alerts</div>"]

    end

end

%% ---------------------------------------------------------
%% PUBLIC ENTRY - RUNTIME TRAFFIC
%% ---------------------------------------------------------

USER -->|"HTTPS"| APPDNS
APPDNS --> APPALB
APPALB -->|"to Pod IP"| FRONTEND

GITHUB -->|"HTTPS webhook"| WHDNS
WHDNS --> WHALB
WHALB -->|"HTTP :8080 · to Pod IP"| CTRL

%% ---------------------------------------------------------
%% OPERATOR ACCESS - PRIVATE, NEVER PUBLISHED
%% ---------------------------------------------------------

OPERATOR --> PF

PF -->|"Jenkins UI"| CTRL
PF -->|"Prometheus UI"| PROM
PF -->|"Grafana UI"| GRAF
PF -->|"Alertmanager UI"| ALERTM

%% ---------------------------------------------------------
%% SCHEDULING - ONLY PODS LAND ON NODES
%% ---------------------------------------------------------

APPPODS -. "Pods scheduled onto" .-> NGAPP
JENPODS -. "Pods scheduled onto<br/>nodeSelector workload=jenkins" .-> NGJEN
OBSPODS -. "Pods scheduled onto<br/>nodeSelector workload=jenkins" .-> NGJEN
NODEEXP -. "One Pod per node" .-> NGAPP
NODEEXP -. "One Pod per node" .-> NGJEN

%% ---------------------------------------------------------
%% CONFIGURATION - AN INGRESS IS NOT A TRAFFIC HOP
%% ---------------------------------------------------------

APPALB -. "Declared by Ingress" .-> APPRES
WHALB -. "Declared by Ingress" .-> JRES

JRES -. "Configures" .-> CTRL
JSVC -. "Selects the Controller Pod" .-> CTRL
JMSVC -. "Selects the Controller Pod" .-> CTRL

%% ---------------------------------------------------------
%% CONFIGURATION - MONITORING OBJECTS ARE RECONCILED, NOT SCRAPED
%% ServiceMonitors and PrometheusRules are declarative objects. The Operator
%% reconciles them into the Prometheus configuration; they carry no metrics.
%% ---------------------------------------------------------

SMAPP -. "Selects ClusterIP Services" .-> APPRES
JSMON -. "Selects the metrics Service" .-> JMSVC

SMAPP -. "Reconciled by Operator" .-> PROMOP
JSMON -. "Reconciled by Operator" .-> PROMOP
OBSRES -. "PrometheusRule reconciled by Operator" .-> PROMOP

PROMOP -. "Configures" .-> PROM

%% ---------------------------------------------------------
%% JENKINS CONTROL / AGENTS
%% ---------------------------------------------------------

CTRL -->|"schedules work"| CIAG
CTRL -->|"schedules work"| CDAG

CTRL -->|"creates Agent Pods"| KAPI
CDAG -->|"deploy · rollout"| KAPI

CIAG -->|"push images"| ECR
CDAG -->|"verify metadata"| ECR

JPVC -.-> EBS

%% ---------------------------------------------------------
%% APPLICATION RUNTIME
%% ---------------------------------------------------------

FRONTEND -->|"HTTP"| BACKEND
FRONTEND -->|"presigned URL"| S3

BACKEND -->|"/notify"| WORKER
BACKEND -->|"PostgreSQL"| RDS
BACKEND -->|"PutObject"| S3

WORKER -->|"Publish"| SNS
SNS -->|"email notification"| MAILAPP

%% ---------------------------------------------------------
%% OBSERVABILITY - SCRAPE, ALERT, STORE
%% ---------------------------------------------------------

PROM -->|"scrapes /metrics"| APPPODS
PROM -->|"scrapes /prometheus/"| CTRL
PROM -->|"scrapes"| KSM
PROM -->|"scrapes"| NODEEXP

KSM -->|"reads object state"| KAPI

GRAF -->|"PromQL queries"| PROM
PROM -->|"fires alerts"| ALERTM
ALERTM -->|"Publish · Pod Identity"| SNSALERT
SNSALERT -->|"email notification"| MAILALERT

CDAG -->|"monitoring gate query<br/>in-cluster Service only"| PROM

PROM -. "Stores time series" .-> OBSPVC
OBSPVC -.-> EBS

%% ---------------------------------------------------------
%% STYLES
%% Same purple palette as the Observability View and Pipeline Flow diagrams:
%%   actor  = outside the platform entirely
%%   entry  = public entry point into the platform
%%   work   = running workload Pods
%%   note   = declared Kubernetes objects and access paths, not workloads
%%   ctx    = AWS-managed Kubernetes control plane
%%   ext    = AWS managed services outside the cluster
%%   mail   = external notification recipient
%%   nodegrp = EC2 capacity a namespace's Pods are scheduled onto
%% Every edge is drawn at twice the default stroke width for readability;
%% the dash pattern of the dotted configuration edges is unaffected.
%% ---------------------------------------------------------

linkStyle default stroke-width:4px,fill:none

classDef actor  fill:#F3F4F6,stroke:#4B5563,stroke-width:2px,color:#111827
classDef entry  fill:#DDD6FE,stroke:#7C3AED,stroke-width:2px,color:#1F2937
classDef work   fill:#EDE9FE,stroke:#6D28D9,stroke-width:2px,color:#1F2937
classDef note   fill:#FFFFFF,stroke:#7C3AED,stroke-width:1px,color:#4C1D95
classDef ctx    fill:#F5F3FF,stroke:#7C3AED,stroke-width:2px,color:#1F2937
classDef ext    fill:#F3F4F6,stroke:#6B7280,stroke-width:1px,color:#1F2937
classDef mail   fill:#FCE7F3,stroke:#BE185D,stroke-width:2px,color:#1F2937
classDef cloud  fill:#FDFCFF,stroke:#4C1D95,stroke-width:2px,color:#3B0764
classDef vpcbox fill:#F5F3FF,stroke:#6D28D9,stroke-width:3px,color:#4C1D95
classDef zone   fill:#FDFCFF,stroke:#4C1D95,stroke-width:2px,color:#3B0764
classDef nodegrp fill:#F5F3FF,stroke:#4C1D95,stroke-width:2px,color:#3B0764

class USER,GITHUB,OPERATOR actor
class MAILAPP,MAILALERT mail
class APPDNS,WHDNS,APPALB,WHALB entry
class FRONTEND,BACKEND,WORKER,CTRL,CIAG,CDAG work
class PROM,GRAF,ALERTM,KSM,NODEEXP,PROMOP work
class PF,APPRES,JSVC,JRES,JPVC note
class SMAPP,JMSVC,JSMON,OBSRES,OBSPVC note
class NGAPP,NGJEN nodegrp
class KAPI ctx
class RDS,ECR,EBS,S3,SNS,SNSALERT ext
class AWS cloud
class VPC vpcbox
class PUBSUB,APPSIDE,APPNS,APPPODS,APPDB,JENSIDE,JENKINSNS,JENPODS,OUTSIDE zone
class OBSSIDE,OBSNS,OBSPODS zone
