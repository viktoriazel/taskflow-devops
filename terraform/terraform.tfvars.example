# -----------------------------------------------------------------------------
# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and replace every placeholder value
# with your real settings BEFORE running terraform plan / apply.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# IMPORTANT: terraform.tfvars is listed in .gitignore and must NEVER be committed.
# -----------------------------------------------------------------------------

aws_region         = "eu-north-1"
project_name       = "taskflow"
environment        = "dev"
db_name            = "todo_db"
db_username        = "REPLACE_WITH_DB_USERNAME"

# Network — safe defaults, change only if these CIDRs conflict with your environment
vpc_cidr                  = "10.0.0.0/16"
private_db_subnet_1_cidr  = "10.0.3.0/24"
private_db_subnet_2_cidr  = "10.0.4.0/24"
public_subnet_1_cidr      = "10.0.11.0/24"
public_subnet_2_cidr      = "10.0.12.0/24"
private_app_subnet_1_cidr = "10.0.13.0/24"
private_app_subnet_2_cidr = "10.0.14.0/24"

# EKS — restrict this to YOUR current public IP as an exact /32, never a wider range
admin_access_cidr = "REPLACE_WITH_YOUR_IP/32"

# SNS — email address that will receive TaskFlow notifications (requires manual confirmation)
sns_notification_email = "REPLACE_WITH_NOTIFICATION_EMAIL"

# DNS — a public domain that YOU own. Manual prerequisites, all of them
# outside the Terraform lifecycle:
#   - a public Route 53 hosted zone for the domain already exists
#   - the registrar's NS records delegate the domain to that hosted zone
# Terraform only reads the zone through a data source; it never creates, owns,
# or destroys the hosted zone or the domain registration.
# The reference deployment of this project uses taskflow.plus.
domain_name = "REPLACE_WITH_YOUR_DOMAIN"
