# Environment variables / secrets
.env
.env.local
*.pem
*.key
id_rsa*
*.csv
*.ods

# Python virtual environments
venv/
.venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Test and lint artifacts - regenerated on every run.
# reports/ holds the JUnit XML that CI publishes as a build artifact; the result
# belongs to a build, not to the source tree.
reports/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*

# Logs
*.log

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local databases
*.db
*.sqlite
*.sqlite3

# Local project notes - not submitted
docs/

# Terraform local runtime/state/secrets
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/terraform.tfstate.d/
terraform/*.tfvars
terraform/*.tfvars.json
terraform/crash.log
terraform/*.tfplan
terraform/tfplan

# Ansible local runtime/secrets
ansible/inventory.ini
ansible/group_vars/all/vars.yml
*.retry
vault_pass*.txt

# Real Secret manifests must never be committed — direct children of k8s/ only.
# Tracked examples live under k8s/examples/*.example.yaml and are unaffected.
/k8s/secret-*.yaml

# Same rule for the Jenkins admin Secret — direct children of jenkins/ only.
# Tracked examples live under jenkins/examples/*.example.yaml and are unaffected.
/jenkins/secret-*.yaml
