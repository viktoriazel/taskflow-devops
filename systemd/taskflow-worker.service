[Unit]
Description=TaskFlow Worker (SNS Email)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/taskflow/worker
EnvironmentFile=/opt/taskflow/worker/.env
ExecStart=/opt/taskflow/worker/venv/bin/gunicorn \
    --workers 1 \
    --bind 0.0.0.0:6000 \
    --timeout 120 \
    worker:app
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
