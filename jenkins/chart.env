# Pinned coordinates of the official Jenkins Helm chart, sourced by the
# install, verify and uninstall scripts. Upgrading the release is one edit here.

JENKINS_CHART_REPO_NAME="jenkins"
JENKINS_CHART_REPO_URL="https://charts.jenkins.io"
JENKINS_CHART_NAME="jenkins"
JENKINS_CHART_VERSION="5.9.54"

# Digest published for the packaged chart. The scripts verify the downloaded
# artifact against it and install from that file, so only a checked chart
# reaches the cluster.
JENKINS_CHART_SHA256="9e539e178a8a7967588933a9507a68fe04b728a1efd240663dc81db8b990e067"

# The namespace is created from jenkins/namespace.yaml before the release.
JENKINS_RELEASE_NAME="jenkins"
JENKINS_NAMESPACE="jenkins"
